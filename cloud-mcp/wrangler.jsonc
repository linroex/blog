{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lins-blog-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://lins-blog-mcp.REPLACE_ME.workers.dev",
    "GITHUB_OWNER": "linroex",
    "GITHUB_REPO": "blog",
    "GITHUB_BRANCH": "main",
    "ALLOWED_GITHUB_USER_ID": "REPLACE_ME",
    "SITE_URL": "https://coder.tw",
    "VALIDATION_WORKFLOW": "mcp-validate.yaml",
    "DEPLOY_WORKFLOW": "hugo.yaml"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
